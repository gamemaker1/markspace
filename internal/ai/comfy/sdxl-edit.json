{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load checkpoint"},
    "inputs": {"ckpt_name": "{{checkpoint}}"}
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": {"title": "Source image"},
    "inputs": {"image": "{{image}}"}
  },
  "11": {
    "class_type": "LoadImage",
    "_meta": {"title": "Mask image, transparent where the image may change"},
    "inputs": {"image": "{{mask}}"}
  },
  "12": {
    "class_type": "VAEEncode",
    "_meta": {"title": "Encode source"},
    "inputs": {"pixels": ["10", 0], "vae": ["4", 2]}
  },
  "13": {
    "class_type": "SetLatentNoiseMask",
    "_meta": {"title": "Apply mask"},
    "inputs": {"samples": ["12", 0], "mask": ["11", 1]}
  },
  "14": {
    "class_type": "RepeatLatentBatch",
    "_meta": {"title": "Batch"},
    "inputs": {"samples": ["13", 0], "amount": "{{batch}}"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt"},
    "inputs": {"text": "{{prompt}}", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative prompt"},
    "inputs": {"text": "{{negative}}", "clip": ["4", 1]}
  },
  "3": {
    "class_type": "KSampler",
    "_meta": {"title": "Sampler"},
    "inputs": {
      "seed": "{{seed}}",
      "steps": 30,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": "{{denoise}}",
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["14", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save"},
    "inputs": {"filename_prefix": "markspace-edit", "images": ["8", 0]}
  }
}
