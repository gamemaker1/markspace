# /.editorconfig
# Tells most editors what our style preferences are.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,makefile}]
indent_style = tab
tab_width = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
