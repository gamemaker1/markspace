# /sdk/example/containerfile
# Builds the image of the word count example plugin.
#
# Build it from the repository root, so the image gets the Python SDK:
#   podman build -f sdk/example/containerfile -t markspace-example .

FROM docker.io/library/python:3.14-slim

RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin plugin \
 && mkdir -p /data \
 && chown plugin:plugin /data \
 && chmod 0700 /data

WORKDIR /app
COPY sdk/python/markspace /app/markspace
COPY sdk/example/example.py /app/example.py

ENV PLUGIN_DATA=/data \
    PORT=8090 \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER plugin
VOLUME /data
EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["python3", "-m", "markspace.health"]

CMD ["python3", "/app/example.py"]
